# ============================================================================
# IPTV Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="IPTV Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://iptv.example.com
API_URL=https://api.iptv.example.com
WS_URL=wss://api.iptv.example.com/ws

# ============================================================================
# Database Configuration
# ============================================================================
MYSQL_ROOT_PASSWORD=your_super_secure_root_password_here
MYSQL_DATABASE=iptv_platform
MYSQL_USER=iptv_user
MYSQL_PASSWORD=your_secure_database_password_here
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Database Connection Pool
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache Settings
CACHE_TTL=3600
SESSION_TTL=86400

# ============================================================================
# Authentication & Security
# ============================================================================
JWT_SECRET=your_jwt_secret_key_min_32_chars_long_random_string
JWT_EXPIRY=86400
JWT_REFRESH_EXPIRY=604800

# Encryption
ENCRYPTION_KEY=your_32_char_encryption_key_here

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================================================
# CDN Configuration
# ============================================================================
CDN_ENABLED=true
CDN_BASE_URL=https://cdn.iptv.example.com
CDN_PROVIDER=cloudflare
CDN_API_KEY=your_cdn_api_key
CDN_ZONE_ID=your_cdn_zone_id

# ============================================================================
# FFmpeg Transcoding
# ============================================================================
FFMPEG_PATH=/usr/bin/ffmpeg
FFMPEG_MAX_WORKERS=4
FFMPEG_WORKER_TIMEOUT=3600
FFMPEG_ENABLE_HARDWARE_ACCEL=false
FFMPEG_HARDWARE_DEVICE=cuda

# Quality Presets
FFMPEG_PRESET_SD=-c:v libx264 -preset fast -b:v 800k -s 640x360 -c:a aac -b:a 96k
FFMPEG_PRESET_HD=-c:v libx264 -preset medium -b:v 2500k -s 1280x720 -c:a aac -b:a 128k
FFMPEG_PRESET_FHD=-c:v libx264 -preset medium -b:v 5000k -s 1920x1080 -c:a aac -b:a 192k
FFMPEG_PRESET_UHD=-c:v libx264 -preset slow -b:v 15000k -s 3840x2160 -c:a aac -b:a 256k

# ============================================================================
# Storage Configuration
# ============================================================================
STORAGE_DRIVER=local
STORAGE_ROOT=/app/storage

# S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=iptv-platform-storage
AWS_ENDPOINT=

# ============================================================================
# SMTP Email Configuration
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@iptv.example.com
SMTP_FROM_NAME="IPTV Platform"
SMTP_ENCRYPTION=tls

# ============================================================================
# Payment Gateways
# ============================================================================

# Stripe
STRIPE_ENABLED=true
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal
PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# ============================================================================
# Push Notifications
# ============================================================================

# Firebase Cloud Messaging (FCM)
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id

# Apple Push Notification Service (APNS)
APNS_ENABLED=true
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id
APNS_BUNDLE_ID=com.iptv.platform
APNS_PRODUCTION=false

# ============================================================================
# Social Authentication
# ============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://iptv.example.com/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://iptv.example.com/auth/facebook/callback

# ============================================================================
# Monitoring & Analytics
# ============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_grafana_password

# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=production

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# API Rate Limits
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000
API_RATE_LIMIT_PER_DAY=10000

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# File Logging
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/app/logs/app.log
LOG_FILE_MAX_SIZE=100
LOG_FILE_MAX_BACKUPS=10
LOG_FILE_MAX_AGE=30

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=iptv-platform-backups

# ============================================================================
# Mobile App Configuration
# ============================================================================
MOBILE_APP_VERSION=2.0.0
MOBILE_APP_MIN_VERSION=1.5.0
MOBILE_APP_FORCE_UPDATE=false

# Download Settings
MOBILE_DOWNLOAD_ENABLED=true
MOBILE_MAX_DOWNLOADS=10
MOBILE_DOWNLOAD_EXPIRY_DAYS=7

# ============================================================================
# AI & ML Configuration
# ============================================================================
AI_RECOMMENDATIONS_ENABLED=true
AI_MODEL_UPDATE_INTERVAL=86400
AI_MIN_RECOMMENDATIONS=5
AI_MAX_RECOMMENDATIONS=50

# Trending Algorithm
TRENDING_WINDOW_HOURS=24
TRENDING_MIN_VIEWS=10

# ============================================================================
# Content Delivery
# ============================================================================
STREAM_PROTOCOL=hls
STREAM_SEGMENT_DURATION=6
STREAM_BUFFER_SIZE=3

# DRM Configuration
DRM_ENABLED=false
DRM_PROVIDER=widevine
DRM_KEY_SERVER=https://drm.example.com

# ============================================================================
# Maintenance Mode
# ============================================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We are currently performing system maintenance. We'll be back shortly."
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# ============================================================================
# Development Settings (DO NOT USE IN PRODUCTION)
# ============================================================================
DEV_MODE=false
DEV_ENABLE_CORS=false
DEV_ENABLE_PROFILER=false
DEV_MOCK_PAYMENTS=false
DEV_MOCK_EMAIL=false

# ============================================================================
# License & White-Label
# ============================================================================
LICENSE_KEY=your_license_key_here
PLATFORM_NAME="IPTV Platform"
PLATFORM_LOGO_URL=https://iptv.example.com/logo.png
PLATFORM_PRIMARY_COLOR=#3B82F6
PLATFORM_SECONDARY_COLOR=#10B981

# ============================================================================
# Third-Party Integrations
# ============================================================================

# EPG Provider
EPG_PROVIDER=xmltv
EPG_API_URL=https://epg.example.com
EPG_API_KEY=your_epg_api_key
EPG_UPDATE_INTERVAL=3600

# TMDb (Movie Database)
TMDB_API_KEY=your_tmdb_api_key
TMDB_ENABLED=true

# GeoIP
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=/app/data/GeoLite2-City.mmdb

# ============================================================================
# WebSocket Configuration
# ============================================================================
WS_ENABLED=true
WS_PORT=8081
WS_MAX_CONNECTIONS=10000
WS_HEARTBEAT_INTERVAL=30

# ============================================================================
# Queue Configuration
# ============================================================================
QUEUE_DRIVER=redis
QUEUE_WORKERS=4
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=60

# ============================================================================
# Session Configuration
# ============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=7200
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://iptv.example.com,https://admin.iptv.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_EXPOSED_HEADERS=
CORS_MAX_AGE=3600
CORS_CREDENTIALS=true

# ============================================================================
# Performance Tuning
# ============================================================================
MAX_UPLOAD_SIZE=100M
MAX_REQUEST_SIZE=100M
REQUEST_TIMEOUT=30
KEEPALIVE_TIMEOUT=65

# Connection Limits
MAX_CONCURRENT_STREAMS=1000
MAX_CONCURRENT_TRANSCODING=10
MAX_CONCURRENT_DOWNLOADS=100

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_WATCH_PARTIES=true
FEATURE_SOCIAL_SHARING=true
FEATURE_USER_PLAYLISTS=true
FEATURE_OFFLINE_DOWNLOADS=true
FEATURE_LIVE_CHAT=true
FEATURE_COMMENTS=true
FEATURE_RATINGS=true
FEATURE_RECOMMENDATIONS=true
FEATURE_TRENDING=true
FEATURE_SEARCH=true
FEATURE_ANALYTICS=true
FEATURE_AB_TESTING=true

# ============================================================================
# End of Configuration
# ============================================================================
