APP_NAME="IPTV Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=iptv_platform
DB_USERNAME=iptv_user
DB_PASSWORD=

# Legacy Database (for migration period)
LEGACY_DB_CONNECTION=mysql
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=7999
LEGACY_DB_DATABASE=xtream_codes
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=iptv_cache

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_PREFIX=iptv_queue

# Redis Configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@iptv.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / CDN Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_CDN_URL=

# Streaming Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
STREAMS_PATH=/var/streams
ARCHIVES_PATH=/var/archives
TEMP_PATH=/tmp/iptv

# Stream Settings
STREAM_SEGMENT_DURATION=10
STREAM_BUFFER_SIZE=8192
STREAM_PREBUFFER_SEGMENTS=3
MAX_CONCURRENT_TRANSCODINGS=5

# Security Configuration
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

ENCRYPTION_KEY=
API_SECRET=

# GeoIP Configuration
GEOIP_DATABASE_PATH=/home/user/pbsupdatingcodex/GeoLite2.mmdb

# Rate Limiting
RATE_LIMIT_API=100
RATE_LIMIT_STREAMING=1000
RATE_LIMIT_LOGIN=5

# Feature Flags
ENABLE_TRANSCODING=true
ENABLE_DVR=true
ENABLE_ANALYTICS=true
ENABLE_CDN=false
ENABLE_LOAD_BALANCING=true

# Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Analytics
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=iptv_analytics
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Broadcasting
BROADCAST_CONNECTION=log
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
