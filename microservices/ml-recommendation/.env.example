# Server Configuration
PORT=8003
WORKERS=2
DEBUG=False

# Database
DATABASE_URL=postgresql+asyncpg://iptv_user:password@postgres:5432/iptv_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256

# ML Model
MODEL_PATH=/app/models
BATCH_SIZE=32
MAX_RECOMMENDATIONS=50

# Training
TRAINING_ENABLED=True
TRAINING_INTERVAL_HOURS=24
