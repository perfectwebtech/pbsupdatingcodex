TRANSCODING__OUTPUT_PATH=/data/output
TRANSCODING__TEMP_PATH=/data/temp

# JWT Configuration
JWT__SECRET=change_me_to_a_very_long_random_string_at_least_32_characters

# Logging
RUST_LOG=info
