# Server Configuration
SERVER__PORT=8002
SERVER__WORKERS=4

# Database Configuration
DATABASE__HOST=postgres
DATABASE__PORT=5432
DATABASE__USERNAME=iptv_user
DATABASE__PASSWORD=change_me_in_production
DATABASE__DATABASE=iptv_platform
DATABASE__MAX_CONNECTIONS=16

# Redis Configuration
REDIS__HOST=redis
REDIS__PORT=6379
