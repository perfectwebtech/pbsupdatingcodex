# Server Configuration
HTTP_PORT=8000
ENVIRONMENT=production

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=iptv_user
DB_PASSWORD=change_me_in_production
DB_NAME=iptv_streaming
DB_SSLMODE=disable
DB_MAX_CONNS=200
DB_MIN_CONNS=20

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=200

# JWT Configuration
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_32_characters

# GeoIP Configuration
GEOIP_DATABASE_PATH=/usr/share/GeoIP/GeoLite2-City.mmdb

# Streaming Configuration
SEGMENT_DURATION=10
BUFFER_SIZE=8192
PREBUFFER_SEGMENTS=3
MAX_BITRATE=8000000
TRANSCODING_ENABLED=false

# CDN Configuration
CDN_ENABLED=false
CDN_BASE_URL=
